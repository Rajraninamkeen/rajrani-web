// BILOKAT — Central Backend (bilokat-api)
// Customer-commerce vertical slice — Session 01 foundation data model.
//
// Conventions (per PROJECT-DOCS/03-DATABASE-DESIGN.md):
//  - IDs: UUIDv7 (default) — generated in app layer; kept uniform here via cuid for simplicity where noted.
//  - Columns: snake_case (@map). Fields camelCase in Prisma.
//  - Timestamps: createdAt / updatedAt. Soft delete via nullable deletedAt.
//  - Status transitions are app-managed (no DB-enforced chains).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  PENDING_VERIFICATION
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum VisibilityStatus {
  LIVE
  HIDDEN
  SCHEDULED
  OUT_OF_STOCK
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum SpiceLevel {
  MILD
  MEDIUM
  SPICY
  FIERY
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

// ============ COMMERCE ============

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
  MERGED
}

enum PaymentMethod {
  COD
  PREPAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD_PENDING
  COD_PAID
  COD_FAILED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum OrderActor {
  CUSTOMER
  SYSTEM
  SELLER
  CONTROL
}

// ============ IDENTITY ============

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  phone     String?    @unique
  passwordHash String? // null => social/OTP-only accounts until verified
  fullName  String?
  status    UserStatus @default(ACTIVE)
  role      String     @default("CUSTOMER") // RBAC role slug; expanded in auth session
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  addresses Address[]
  reviews   ProductReview[]
  sessions  UserSession[]
  carts     Cart[]
  orders    Order[]
  codVerifications CodVerification[]

  @@map("users")
}

// Refresh-token / device session registry (DB-design §15 User Session).
// Used for refresh-token rotation, revocation, and session listing.
model UserSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique // hash of the current refresh token (never store raw)
  ip        String?
  userAgent String?
  deviceName String?
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("user_sessions")
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType @default(HOME)
  label     String? // e.g. "Home", "Office"
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String // 6-digit Indian pincode
  country   String      @default("India")
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============ CATALOG ============

// Dynamic category tree (per Master Spec §18).
model Category {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  description String?
  parentId  String?
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]     @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int            @default(0)
  status    CategoryStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  tagline         String?
  description     String?
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  brand           String?
  regionOrigin    String? // seller-declared origin
  status          ProductStatus    @default(DRAFT)
  visibility      VisibilityStatus @default(HIDDEN)
  // Selling price (authoritative source of truth). originalPrice is the MRP
  // shown as strike-through. weightLabel is the pack weight for the default unit.
  basePrice       Decimal          @db.Decimal(10, 2)
  originalPrice   Decimal?         @db.Decimal(10, 2)
  weightLabel     String? // e.g. "400g Zip-Pouch"
  spiceLevel      SpiceLevel?
  ingredients     String[]         @default([]) // stored as JSON array column
  nutritional     Json? // calories/protein/fat/carbs
  // Aggregate review snapshot (kept current by the reviews service when present).
  ratingAvg       Float            @default(0)
  reviewCount     Int              @default(0)
  stockStatus     StockStatus      @default(OUT_OF_STOCK)
  stockOnHand     Int              @default(0)
  isBestseller    Boolean          @default(false)
  isNew           Boolean          @default(false)
  pairingSuggestion String?
  customerFavTag  String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  variants  ProductVariant[]
  media     ProductMedia[]
  reviews   ProductReview[]
  cartItems CartItem[]

  @@index([categoryId])
  @@index([status])
  @@index([visibility])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String? // e.g. "200g", "Jar 400g"
  weightGrams Int?
  price     Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2) // for strike-through / discount display
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  kind      String   @default("IMAGE") // IMAGE | VIDEO
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_media")
}

model ProductReview {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  rating      Int // 1..5
  title       String?
  comment     String?
  status      ReviewStatus @default(PENDING)
  verifiedBuyer Boolean     @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

// ============ PROMOTION ============

model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  type        CouponType
  value       Decimal     @db.Decimal(10, 2) // percentage points OR fixed amount depending on type
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxDiscount Decimal?    @db.Decimal(10, 2)
  status      CouponStatus @default(ACTIVE)
  validFrom   DateTime?
  validTo     DateTime?
  usageLimit  Int?
  usageCount  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("coupons")
}

// ============ COMMERCE MODELS ============

// Cart: associated with a logged-in user OR a guest session id (one of the two).
model Cart {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String? // opaque client-generated id for guest carts
  status         CartStatus @default(ACTIVE)
  currency       String     @default("INR")
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items CartItem[]

  @@unique([guestSessionId])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// Customer-facing order (single-seller vertical slice). Snapshots preserve the
// commercial record even if catalog data changes later (Master-Spec §38).
model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PLACED)
  currency       String   @default("INR")
  // money (all in paise-safe Decimal)
  subtotal       Decimal  @db.Decimal(12, 2)
  discountTotal  Decimal  @db.Decimal(12, 2) @default(0)
  taxTotal       Decimal  @db.Decimal(12, 2) @default(0)
  deliveryTotal  Decimal  @db.Decimal(12, 2) @default(0)
  grandTotal     Decimal  @db.Decimal(12, 2)
  couponCode     String?
  couponDiscount Decimal  @db.Decimal(12, 2) @default(0)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  // address snapshot (order_addresses per DB design)
  addressSnapshot Json
  placedAt       DateTime @default(now())
  cancelledAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items   OrderItem[]
  history OrderStatusHistory[]
  payment Payment?
  codVerification CodVerification?
  returnRequests ReturnRequest[]
  refunds Refund[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String @id @default(cuid())
  orderId           String
  order             Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  productNameSnapshot String
  skuSnapshot       String?
  weightSnapshot    String?
  unitPrice         Decimal @db.Decimal(12, 2) // selling price at purchase
  quantity          Int
  lineTotal         Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus  OrderStatus
  actor     OrderActor @default(SYSTEM)
  actorId   String?
  reason    String?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([orderId])
  @@map("order_status_history")
}


// --- Session 05: online payment intent + COD verification (DB-Design §§64-71) ---

enum PaymentState {
  INITIATED
  PENDING
  AUTHORIZED
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionType {
  CHARGE
  CAPTURE
  REFUND
  REVERSAL
}

enum CodVerificationStatus {
  PENDING_CUSTOMER_OTP
  OTP_VERIFIED
  CONFIRMED
  REJECTED
  EXPIRED
}

// Server-authoritative record of a payment intent for an order.
// Never store raw card/credentials here (DB-Design §64).
model Payment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentReference  String   @unique // internal PAY-XXXX reference
  provider          String   @default("sandbox") // pluggable gateway (sandbox/razorpay/...)
  method            PaymentMethod
  state             PaymentState @default(PENDING)
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("INR")
  providerPaymentId String? // gateway-side payment/intent id
  providerCaptureId String?
  idempotencyKey    String?  @unique // to safely retry confirm/capture
  errorCode         String?
  errorMessage      String?
  expiresAt         DateTime?
  confirmedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactions PaymentTransaction[]
  webhooks     PaymentWebhook[]
  refunds      Refund[]

  @@index([orderId])
  @@map("payments")
}

// Ledger-style record of each authoritative gateway transaction (DB-Design §68).
model PaymentTransaction {
  id                String                @id @default(cuid())
  paymentId         String
  payment           Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionType   PaymentTransactionType
  amount            Decimal               @db.Decimal(12, 2)
  currency          String                @default("INR")
  providerReference String?
  status            String                @default("SUCCESS") // SUCCESS | FAILED
  metadata          Json?
  createdAt         DateTime              @default(now())

  @@index([paymentId])
  @@map("payment_transactions")
}

// Immutable inbound webhook/confirm event log. UNIQUE(provider, providerEventId)
// provides idempotency; signature_verified + payload_hash support audit (DB-Design §67).
model PaymentWebhook {
  id                String   @id @default(cuid())
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider          String   @default("sandbox")
  providerEventId   String
  eventType         String
  signatureVerified Boolean  @default(false)
  payloadHash       String?
  processingStatus  String   @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  failureReason     String?
  receivedAt        DateTime @default(now())
  processedAt       DateTime?

  @@unique([provider, providerEventId])
  @@map("payment_webhooks")
}

// COD verification record (DB-Design §69). Only a hash of the OTP is stored and
// it is expired quickly; the raw code is never persisted.
model CodVerification {
  id                String                 @id @default(cuid())
  orderId           String                 @unique
  order             Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId            String
  user              User                   @relation(fields: [userId], references: [id])
  primaryContact    String?
  secondaryContact  String?                // the mobile being OTP-verified
  status            CodVerificationStatus  @default(PENDING_CUSTOMER_OTP)
  otpHash           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int                    @default(0)
  decision          String?
  decisionReason    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  completedAt       DateTime?

  @@index([orderId])
  @@map("cod_verifications")
}

// --- Session 07: returns & refunds (DB-Design §§85-92) ---
// Backend is the sole authority for refund eligibility/amount/status.

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnReasonCode {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  MISSING_ITEM
  NOT_AS_DESCRIBED
  QUALITY_ISSUE
  DELIVERY_LATE
  NO_LONGER_NEEDED
  OTHER
}

enum RefundMethod {
  GATEWAY // PREPAID: money back to the original payment source
  COD     // cash order: refunded out-of-band (UPI/cash)
}

enum RefundState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Whole-order return request tied to the order lifecycle. Eligibility + window
// are evaluated server-side (ReturnService). Deferred: item-level partial
// returns, pickup scheduling, warehouse inspection.
model ReturnRequest {
  id               String             @id @default(cuid())
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           ReturnStatus       @default(REQUESTED)
  reasonCode       ReturnReasonCode
  reasonNote       String?            // optional free-text elaboration
  evidenceRequired Boolean            @default(false)
  requestedAt      DateTime           @default(now())
  approvedAt       DateTime?
  rejectedAt       DateTime?
  decisionBy       String?            // operator user id that decided
  decisionReason   String?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  refund Refund?

  @@index([orderId])
  @@map("return_requests")
}

// Server-authoritative refund for a return. amount <= order.grandTotal enforced
// in service; status transitions guarded. gateway_ref + idempotency for audit.
model Refund {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequestId  String        @unique
  returnRequest    ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundReference  String        @unique // RFD-XXXX internal reference
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("INR")
  method           RefundMethod
  status           RefundState   @default(PENDING)
  gatewayProvider  String        @default("sandbox")
  gatewayRef       String?
  reason           String?
  initiatedById    String?
  initiatedAt      DateTime      @default(now())
  completedAt      DateTime?
  failedReason     String?
  idempotencyKey   String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orderId])
  @@map("refunds")
}
