// BILOKAT — Central Backend (bilokat-api)
// Customer-commerce vertical slice — Session 01 foundation data model.
//
// Conventions (per PROJECT-DOCS/03-DATABASE-DESIGN.md):
//  - IDs: UUIDv7 (default) — generated in app layer; kept uniform here via cuid for simplicity where noted.
//  - Columns: snake_case (@map). Fields camelCase in Prisma.
//  - Timestamps: createdAt / updatedAt. Soft delete via nullable deletedAt.
//  - Status transitions are app-managed (no DB-enforced chains).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  PENDING_VERIFICATION
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum VisibilityStatus {
  LIVE
  HIDDEN
  SCHEDULED
  OUT_OF_STOCK
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum SpiceLevel {
  MILD
  MEDIUM
  SPICY
  FIERY
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

// ============ COMMERCE ============

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
  MERGED
}

enum PaymentMethod {
  COD
  PREPAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD_PENDING
  COD_PAID
  COD_FAILED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum OrderActor {
  CUSTOMER
  SYSTEM
  SELLER
  CONTROL
}

// ============ IDENTITY ============

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  phone     String?    @unique
  passwordHash String? // null => social/OTP-only accounts until verified
  fullName  String?
  status    UserStatus @default(ACTIVE)
  role      String     @default("CUSTOMER") // RBAC role slug; expanded in auth session
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  addresses Address[]
  reviews   ProductReview[]
  sessions  UserSession[]
  carts     Cart[]
  orders    Order[]

  @@map("users")
}

// Refresh-token / device session registry (DB-design §15 User Session).
// Used for refresh-token rotation, revocation, and session listing.
model UserSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique // hash of the current refresh token (never store raw)
  ip        String?
  userAgent String?
  deviceName String?
  expiresAt DateTime
  revokedAt DateTime?
  replacedByTokenId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("user_sessions")
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType @default(HOME)
  label     String? // e.g. "Home", "Office"
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String // 6-digit Indian pincode
  country   String      @default("India")
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============ CATALOG ============

// Dynamic category tree (per Master Spec §18).
model Category {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  description String?
  parentId  String?
  parent    Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]     @relation("CategoryTree")
  imageUrl  String?
  sortOrder Int            @default(0)
  status    CategoryStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  tagline         String?
  description     String?
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  brand           String?
  regionOrigin    String? // seller-declared origin
  status          ProductStatus    @default(DRAFT)
  visibility      VisibilityStatus @default(HIDDEN)
  // Selling price (authoritative source of truth). originalPrice is the MRP
  // shown as strike-through. weightLabel is the pack weight for the default unit.
  basePrice       Decimal          @db.Decimal(10, 2)
  originalPrice   Decimal?         @db.Decimal(10, 2)
  weightLabel     String? // e.g. "400g Zip-Pouch"
  spiceLevel      SpiceLevel?
  ingredients     String[]         @default([]) // stored as JSON array column
  nutritional     Json? // calories/protein/fat/carbs
  // Aggregate review snapshot (kept current by the reviews service when present).
  ratingAvg       Float            @default(0)
  reviewCount     Int              @default(0)
  stockStatus     StockStatus      @default(OUT_OF_STOCK)
  stockOnHand     Int              @default(0)
  isBestseller    Boolean          @default(false)
  isNew           Boolean          @default(false)
  pairingSuggestion String?
  customerFavTag  String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  variants  ProductVariant[]
  media     ProductMedia[]
  reviews   ProductReview[]
  cartItems CartItem[]

  @@index([categoryId])
  @@index([status])
  @@index([visibility])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  name      String? // e.g. "200g", "Jar 400g"
  weightGrams Int?
  price     Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2) // for strike-through / discount display
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  kind      String   @default("IMAGE") // IMAGE | VIDEO
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_media")
}

model ProductReview {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  rating      Int // 1..5
  title       String?
  comment     String?
  status      ReviewStatus @default(PENDING)
  verifiedBuyer Boolean     @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

// ============ PROMOTION ============

model Coupon {
  id          String      @id @default(cuid())
  code        String      @unique
  type        CouponType
  value       Decimal     @db.Decimal(10, 2) // percentage points OR fixed amount depending on type
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxDiscount Decimal?    @db.Decimal(10, 2)
  status      CouponStatus @default(ACTIVE)
  validFrom   DateTime?
  validTo     DateTime?
  usageLimit  Int?
  usageCount  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("coupons")
}

// ============ COMMERCE MODELS ============

// Cart: associated with a logged-in user OR a guest session id (one of the two).
model Cart {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String? // opaque client-generated id for guest carts
  status         CartStatus @default(ACTIVE)
  currency       String     @default("INR")
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items CartItem[]

  @@unique([guestSessionId])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// Customer-facing order (single-seller vertical slice). Snapshots preserve the
// commercial record even if catalog data changes later (Master-Spec §38).
model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PLACED)
  currency       String   @default("INR")
  // money (all in paise-safe Decimal)
  subtotal       Decimal  @db.Decimal(12, 2)
  discountTotal  Decimal  @db.Decimal(12, 2) @default(0)
  taxTotal       Decimal  @db.Decimal(12, 2) @default(0)
  deliveryTotal  Decimal  @db.Decimal(12, 2) @default(0)
  grandTotal     Decimal  @db.Decimal(12, 2)
  couponCode     String?
  couponDiscount Decimal  @db.Decimal(12, 2) @default(0)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  // address snapshot (order_addresses per DB design)
  addressSnapshot Json
  placedAt       DateTime @default(now())
  cancelledAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items   OrderItem[]
  history OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                String @id @default(cuid())
  orderId           String
  order             Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  productNameSnapshot String
  skuSnapshot       String?
  weightSnapshot    String?
  unitPrice         Decimal @db.Decimal(12, 2) // selling price at purchase
  quantity          Int
  lineTotal         Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus  OrderStatus
  actor     OrderActor @default(SYSTEM)
  actorId   String?
  reason    String?
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

