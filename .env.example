# BILOKAT API — Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env`.

# --- Application ---
NODE_ENV=development
PORT=4000
# Public base URL of the API (used for links, CORS in prod)
API_BASE_URL=http://localhost:4000

# Allowed CORS origins (comma-separated). '*' for dev only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) ---
# Prisma datasource url. Docker-compose default below.
DATABASE_URL=postgresql://bilokat:bilokat_dev@localhost:5432/bilokat?schema=public

# --- Redis (cache / queues later) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Security ---
# MUST be a long random string in production. Change before any real use.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=1209600     # seconds (14 days)

# --- Logging ---
LOG_LEVEL=debug

# --- Payments (Session 18) ---
# Provider: 'sandbox' (default) or 'razorpay'. Sandbox makes no external calls and
# fabricates gateway references, exactly as before. 'razorpay' talks to the real
# Razorpay REST API (default https://api.razorpay.com; RAZORPAY_BASE_URL can point
# at a local Razorpay-protocol mock for offline E2E).
# Legacy sandbox signed-body webhook secret (used only when provider=sandbox):
PAYMENT_WEBHOOK_SECRET=bilokat-sandbox-webhook-secret-do-not-use-in-prod
# Razorpay (only read when PAYMENT_GATEWAY_PROVIDER=razorpay):
PAYMENT_GATEWAY_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_BASE_URL=https://api.razorpay.com
