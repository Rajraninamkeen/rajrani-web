// BILOKAT — Central Backend (bilokat-api)
// Customer-commerce vertical slice — Session 01 foundation data model.
//
// Conventions (per PROJECT-DOCS/03-DATABASE-DESIGN.md):
//  - IDs: UUIDv7 (default) — generated in app layer; kept uniform here via cuid for simplicity where noted.
//  - Columns: snake_case (@map). Fields camelCase in Prisma.
//  - Timestamps: createdAt / updatedAt. Soft delete via nullable deletedAt.
//  - Status transitions are app-managed (no DB-enforced chains).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  PENDING_VERIFICATION
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum VisibilityStatus {
  LIVE
  HIDDEN
  SCHEDULED
  OUT_OF_STOCK
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum SpiceLevel {
  MILD
  MEDIUM
  SPICY
  FIERY
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

// ============ COMMERCE ============

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
  MERGED
}

enum PaymentMethod {
  COD
  PREPAID
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD_PENDING
  COD_PAID
  COD_FAILED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUND_PENDING
  REFUNDED
}

enum OrderActor {
  CUSTOMER
  SYSTEM
  SELLER
  CONTROL
}

// ============ IDENTITY ============

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  phone           String?              @unique
  passwordHash    String? // null => social/OTP-only accounts until verified
  fullName        String?
  status          UserStatus           @default(ACTIVE)
  role            String               @default("CUSTOMER") // RBAC role slug; expanded in auth session
  // Optional binding for SELLER-role users: which seller org they operate for
  // (Session 09 split-checkout; organisations/org-members is a later refinement).
  sellerId        String?
  seller          Seller?              @relation("SellerOperators", fields: [sellerId], references: [id])
  memberships     OrganizationMember[] // Session 14: org memberships (seller operator owners)
  deliveryPartner DeliveryPartner? // Session 15: DELIVERY-role partner profile
  notifications   Notification[]  // Session 38: in-app finance/payout notification ledger
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  addresses        Address[]
  wishlist         WishlistItem[]
  reviews          ProductReview[]
  sessions         UserSession[]
  carts            Cart[]
  orders           Order[]
  codVerifications CodVerification[]

  @@index([sellerId])
  @@map("users")
}

// Refresh-token / device session registry (DB-design §15 User Session).
// Used for refresh-token rotation, revocation, and session listing.
model UserSession {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String    @unique // hash of the current refresh token (never store raw)
  ip                String?
  userAgent         String?
  deviceName        String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@map("user_sessions")
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType @default(HOME)
  label     String? // e.g. "Home", "Office"
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String // 6-digit Indian pincode
  country   String      @default("India")
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("addresses")
}

// ============ WISHLIST (customer) ============
// A signed-in CUSTOMER's saved products (Session 47). One row per (user, product);
// a toggle add/remove keeps it idempotent. Guest wishlist is intentionally not
// supported — wishlist is tied to the account (unlike guest cart which merges).
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

// ============ CATALOG ============

// Dynamic category tree (per Master Spec §18).
model Category {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  parentId    String?
  parent      Category?      @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]     @relation("CategoryTree")
  imageUrl    String?
  sortOrder   Int            @default(0)
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  tagline           String?
  description       String?
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  // Owning seller (Session 09 multi-seller catalog / split-checkout).
  sellerId          String
  seller            Seller           @relation(fields: [sellerId], references: [id])
  brand             String?
  regionOrigin      String? // seller-declared origin
  status            ProductStatus    @default(DRAFT)
  visibility        VisibilityStatus @default(HIDDEN)
  // Selling price (authoritative source of truth). originalPrice is the MRP
  // shown as strike-through. weightLabel is the pack weight for the default unit.
  basePrice         Decimal          @db.Decimal(10, 2)
  originalPrice     Decimal?         @db.Decimal(10, 2)
  weightLabel       String? // e.g. "400g Zip-Pouch"
  spiceLevel        SpiceLevel?
  ingredients       String[]         @default([]) // stored as JSON array column
  nutritional       Json? // calories/protein/fat/carbs
  // Aggregate review snapshot (kept current by the reviews service when present).
  ratingAvg         Float            @default(0)
  reviewCount       Int              @default(0)
  stockStatus       StockStatus      @default(OUT_OF_STOCK)
  stockOnHand       Int              @default(0)
  isBestseller      Boolean          @default(false)
  isNew             Boolean          @default(false)
  pairingSuggestion String?
  customerFavTag    String?
  publishedAt       DateTime?
  // Last catalog-review note (approve/reject reason) surfaced to the seller (Session 20).
  reviewNote        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  variants      ProductVariant[]
  media         ProductMedia[]
  reviews       ProductReview[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  statusHistory ProductStatusHistory[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
  @@index([visibility])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  name          String? // e.g. "200g", "Jar 400g"
  weightGrams   Int?
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2) // for strike-through / discount display
  stock         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  kind      String   @default("IMAGE") // IMAGE | VIDEO
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_media")
}

model ProductReview {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  rating         Int // 1..5
  title          String?
  comment        String?
  status         ReviewStatus @default(PENDING)
  verifiedBuyer  Boolean      @default(false)
  // Session 21 — moderation audit (actor + note/reason, when the review was acted on).
  moderatorId    String?
  moderatedAt    DateTime?
  moderationNote String? // staff note; required reason on reject, optional on approve/hide/unhide
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // One review per customer per product (a repeat buyer updates their own review).
  @@unique([productId, userId])
  @@index([productId])
  @@index([userId, status])
  @@map("product_reviews")
}

// ============ PROMOTION ============

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          CouponType
  value         Decimal      @db.Decimal(10, 2) // percentage points OR fixed amount depending on type
  minOrderValue Decimal?     @db.Decimal(10, 2)
  maxDiscount   Decimal?     @db.Decimal(10, 2)
  status        CouponStatus @default(ACTIVE)
  validFrom     DateTime?
  validTo       DateTime?
  usageLimit    Int?
  usageCount    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("coupons")
}

// ============ COMMERCE MODELS ============

// Cart: associated with a logged-in user OR a guest session id (one of the two).
model Cart {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String? // opaque client-generated id for guest carts
  status         CartStatus @default(ACTIVE)
  currency       String     @default("INR")
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  items CartItem[]

  @@unique([guestSessionId])
  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// Customer-facing order (single-seller vertical slice). Snapshots preserve the
// commercial record even if catalog data changes later (Master-Spec §38).
model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PLACED)
  currency        String        @default("INR")
  // money (all in paise-safe Decimal)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  deliveryTotal   Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  couponCode      String?
  couponDiscount  Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  // address snapshot (order_addresses per DB design)
  addressSnapshot Json
  placedAt        DateTime      @default(now())
  cancelledAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items                  OrderItem[]
  sellerOrders           SellerOrder[]
  deliveryAssignments    DeliveryAssignment[] // Session 15
  history                OrderStatusHistory[]
  payment                Payment?
  codVerification        CodVerification?
  returnRequests         ReturnRequest[]
  refunds                Refund[]
  replacements           Replacement[] // Session 16
  replacementAssignments ReplacementAssignment[] // Session 22: courier leg of a dispatched replacement
  payables               SellerPayable[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String      @id @default(cuid())
  orderId             String
  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The per-seller sub-order (Session 09 split-checkout) this line belongs to.
  sellerOrderId       String
  sellerOrder         SellerOrder @relation(fields: [sellerOrderId], references: [id])
  productId           String
  productNameSnapshot String
  sellerNameSnapshot  String? // seller display name at purchase (catalog may change)
  skuSnapshot         String?
  weightSnapshot      String?
  unitPrice           Decimal     @db.Decimal(12, 2) // selling price at purchase
  quantity            Int
  lineTotal           Decimal     @db.Decimal(12, 2)

  returnItems ReturnItem[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      OrderActor   @default(SYSTEM)
  actorId    String?
  reason     String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

// --- Session 05: online payment intent + COD verification (DB-Design §§64-71) ---

enum PaymentState {
  INITIATED
  PENDING
  AUTHORIZED
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentTransactionType {
  CHARGE
  CAPTURE
  REFUND
  REVERSAL
}

enum CodVerificationStatus {
  PENDING_CUSTOMER_OTP
  OTP_VERIFIED
  CONFIRMED
  REJECTED
  EXPIRED
}

// Server-authoritative record of a payment intent for an order.
// Never store raw card/credentials here (DB-Design §64).
model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentReference  String        @unique // internal PAY-XXXX reference
  provider          String        @default("sandbox") // pluggable gateway (sandbox/razorpay/...)
  method            PaymentMethod
  state             PaymentState  @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR")
  providerPaymentId String? // gateway-side payment/intent id
  providerCaptureId String?
  idempotencyKey    String?       @unique // to safely retry confirm/capture
  errorCode         String?
  errorMessage      String?
  expiresAt         DateTime?
  confirmedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  transactions PaymentTransaction[]
  webhooks     PaymentWebhook[]
  refunds      Refund[]

  @@index([orderId])
  @@map("payments")
}

// Ledger-style record of each authoritative gateway transaction (DB-Design §68).
model PaymentTransaction {
  id                String                 @id @default(cuid())
  paymentId         String
  payment           Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  transactionType   PaymentTransactionType
  amount            Decimal                @db.Decimal(12, 2)
  currency          String                 @default("INR")
  providerReference String?
  status            String                 @default("SUCCESS") // SUCCESS | FAILED
  metadata          Json?
  createdAt         DateTime               @default(now())

  @@index([paymentId])
  @@map("payment_transactions")
}

// Immutable inbound webhook/confirm event log. UNIQUE(provider, providerEventId)
// provides idempotency; signature_verified + payload_hash support audit (DB-Design §67).
model PaymentWebhook {
  id                String    @id @default(cuid())
  paymentId         String?
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider          String    @default("sandbox")
  providerEventId   String
  eventType         String
  signatureVerified Boolean   @default(false)
  payloadHash       String?
  processingStatus  String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  failureReason     String?
  receivedAt        DateTime  @default(now())
  processedAt       DateTime?

  @@unique([provider, providerEventId])
  @@map("payment_webhooks")
}

// COD verification record (DB-Design §69). Only a hash of the OTP is stored and
// it is expired quickly; the raw code is never persisted.
model CodVerification {
  id               String                @id @default(cuid())
  orderId          String                @unique
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId           String
  user             User                  @relation(fields: [userId], references: [id])
  primaryContact   String?
  secondaryContact String? // the mobile being OTP-verified
  status           CodVerificationStatus @default(PENDING_CUSTOMER_OTP)
  otpHash          String?
  otpExpiresAt     DateTime?
  otpAttempts      Int                   @default(0)
  decision         String?
  decisionReason   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  completedAt      DateTime?

  @@index([orderId])
  @@map("cod_verifications")
}

// --- Session 07/08: returns & refunds (DB-Design §§85-92) ---
// Item-level, full-lifecycle returns. Backend is the sole authority for refund
// eligibility/amount/status. Refund amounts are server-allocated proportionally
// from the order grand total and adjusted by inspection results.

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  INSPECTION
  APPROVED_FOR_REFUND
  COMPLETED
  CANCELLED
  REPLACEMENT_ISSUED // Session 16: terminal state when a return is resolved as a replacement
}

// Session 16: the remedy a customer wants for a return.
enum ReturnResolution {
  REFUND
  REPLACEMENT
}

enum ReturnReasonCode {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  MISSING_ITEM
  NOT_AS_DESCRIBED
  QUALITY_ISSUE
  DELIVERY_LATE
  NO_LONGER_NEEDED
  OTHER
}

enum ReturnEventType {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  INSPECTION
  APPROVED_FOR_REFUND
  REFUND_INITIATED
  REFUND_COMPLETED
  REFUND_PROCESSING // Session 18 (async gateway refund submitted)
  REFUND_FAILED // Session 19 (gateway refund.failed -> Refund FAILED, request stays open)
  REPLACEMENT_ISSUED // Session 16
  REPLACEMENT_DISPATCHED // Session 17
  REPLACEMENT_COMPLETED // Session 17
  REPLACEMENT_CANCELLED // Session 17
  // Session 22 — replacement courier last-mile steps (audited on the same return trail)
  REPLACEMENT_COURIER_ASSIGNED // operator assigned a DELIVERY partner to deliver the replacement
  REPLACEMENT_COURIER_ACCEPTED // partner accepted the assignment
  REPLACEMENT_COURIER_REJECTED // partner declined (operator reassigns)
  REPLACEMENT_COURIER_PICKED_UP // partner collected the replacement
  REPLACEMENT_COURIER_OUT_FOR_DELIVERY // partner is en route to the customer
  REPLACEMENT_COURIER_CANCELLED // operator cancelled the assignment
  REPLACEMENT_COURIER_FAILED // partner reported a failed delivery attempt
  EVIDENCE_UPLOADED // Session 16
  CANCELLED
}

enum ReturnActorType {
  CUSTOMER
  OPERATOR
  SYSTEM
  DELIVERY // Session 22: a DELIVERY-role courier acting on a replacement assignment
}

enum InspectionResult {
  PASS
  PARTIAL_PASS
  FAIL
}

enum RefundMethod {
  GATEWAY // PREPAID: money back to the original payment source
  COD // cash order: refunded out-of-band (UPI/cash)
}

enum RefundState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// A customer return request over one or more of the order's line items
// (return_items below). Its own ReturnStatus drives the pickup/inspection/
// refund lifecycle; ReturnEvents provide an immutable per-request audit trail.
model ReturnRequest {
  id                  String            @id @default(cuid())
  orderId             String
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status              ReturnStatus      @default(REQUESTED)
  resolution          ReturnResolution? // Session 16: requested remedy (REFUND default; REPLACEMENT for exchange)
  reasonCode          ReturnReasonCode
  reasonNote          String?
  evidenceRequired    Boolean           @default(false)
  requestedAt         DateTime          @default(now())
  approvedAt          DateTime?
  rejectedAt          DateTime?
  decisionBy          String?
  decisionReason      String?
  pickupScheduledAt   DateTime?
  pickedUpAt          DateTime?
  inspectedAt         DateTime?
  approvedForRefundAt DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  items       ReturnItem[]
  events      ReturnEvent[]
  refund      Refund?
  evidence    ReturnEvidence[]
  replacement Replacement?

  @@index([orderId])
  @@map("return_requests")
}

// One line of the return: a quantity of a single purchased order item.
// refundAmount is finalised server-side at APPROVED_FOR_REFUND from the
// proportional grand-total allocation adjusted by the inspection result.
model ReturnItem {
  id                   String            @id @default(cuid())
  returnRequestId      String
  returnRequest        ReturnRequest     @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId          String
  orderItem            OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity             Int // number of units being returned
  conditionNotes       String?
  inspectionResult     InspectionResult?
  refundAmount         Decimal?          @db.Decimal(12, 2)
  replacementRequested Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  inspection ReturnInspection?

  @@unique([returnRequestId, orderItemId])
  @@map("return_items")
}

// Immutable per-request lifecycle audit (DB-Design §88).
model ReturnEvent {
  id              String          @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  eventType       ReturnEventType
  actorType       ReturnActorType
  actorId         String?
  reason          String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([returnRequestId])
  @@map("return_events")
}

// Result of physically inspecting a returned line (DB-Design §89). A PARTIAL_PASS
// or FAIL result reduces that line's refundable amount per policy.
model ReturnInspection {
  id                String           @id @default(cuid())
  returnItemId      String           @unique
  returnItem        ReturnItem       @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  inspectorId       String? // operator user id
  result            InspectionResult
  conditionNotes    String?
  evidenceStorageId String?
  createdAt         DateTime         @default(now())

  @@map("return_inspections")
}

// Session 16: customer-supplied evidence (photos/videos) on a return request.
// Storage-intent only — stores an object reference, never the binary. Usually
// required for REPLACEMENT / defect-related returns.
model ReturnEvidence {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  storageObjectId String        @unique
  fileName        String
  mimeType        String?
  sizeBytes       Int?
  kind            String        @default("IMAGE") // IMAGE | VIDEO
  uploadedBy      String?
  uploadedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
  @@map("return_evidence")
}

// Session 16: a replacement (exchange) resolved from a return. No money refund is
// created for a REPLACEMENT-resolution return; the replacement captures the units
// to be re-supplied (outbound dispatch is a later fulfilment concern).
enum ReplacementStatus {
  PENDING_DISPATCH
  DISPATCHED
  COMPLETED
  CANCELLED
}

model Replacement {
  id                   String            @id @default(cuid())
  returnRequestId      String            @unique
  returnRequest        ReturnRequest     @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderId              String
  order                Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId        String? // slice the returned/replacement goods belong to
  replacementReference String            @unique // RPL-XXXX
  status               ReplacementStatus @default(PENDING_DISPATCH)
  quantityTotal        Int
  issuedBy             String?
  issuedAt             DateTime          @default(now())
  dispatchedAt         DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  // Session 17: outbound dispatch metadata (additive)
  dispatchReference    String?
  dispatchNote         String?
  dispatchBy           String?
  cancellationReason   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  assignments ReplacementAssignment[] // Session 22: courier assignment(s) to deliver this replacement

  @@index([orderId])
  @@index([returnRequestId])
  @@map("replacements")
}

// Server-authoritative refund. amount is derived from approved return items and
// is <= order.grandTotal (enforced in service). status transitions guarded.
model Refund {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // A Refund is normally attached to a ReturnRequest (returns/refunds). For
  // Session 11 partial-fulfilment it may instead be NULL and tied to a cancelled
  // seller slice via sellerOrderId (no return request involved). PG unique allows
  // many NULLs, so returnRequestId stays one-to-one for return refunds.
  returnRequestId String?        @unique
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  sellerOrderId   String?
  sellerOrder     SellerOrder?   @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  paymentId       String?
  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  refundReference String         @unique // RFD-XXXX
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR")
  method          RefundMethod
  status          RefundState    @default(PENDING)
  gatewayProvider String         @default("sandbox")
  gatewayRef      String?
  reason          String?
  initiatedById   String?
  initiatedAt     DateTime       @default(now())
  completedAt     DateTime?
  failedReason    String?
  idempotencyKey  String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  transactions RefundTransaction[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@map("refunds")
}

// Ledger of each refund gateway action (DB-Design §92).
model RefundTransaction {
  id                String    @id @default(cuid())
  refundId          String
  refund            Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  provider          String    @default("sandbox")
  providerReference String?
  amount            Decimal   @db.Decimal(12, 2)
  status            String    @default("PENDING") // PENDING | SUCCESS | FAILED
  failureReason     String?
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  @@index([refundId])
  @@map("refund_transactions")
}

// ===================== Session 09: Seller orgs + split-checkout =====================

enum SellerStatus {
  REGISTERED // account created; profile/application not yet complete (Session 14)
  PENDING // awaiting profile completion / submission
  UNDER_REVIEW // application submitted; reviewer acting on it
  APPROVED // onboarding approved; not yet activated
  ACTIVE // approved + activated: may operate (existing operational gate value)
  REJECTED // onboarding rejected
  SUSPENDED
  DEACTIVATED
}

enum SellerOrderStatus {
  PLACED // created at checkout, awaiting seller confirmation
  ACCEPTED // seller confirmed they will fulfil their slice
  REJECTED // seller declined their slice (reason recorded)
  CANCELLED // whole order cancelled
}

model Seller {
  id                String        @id @default(cuid())
  sellerCode        String        @unique
  legalName         String
  displayName       String
  status            SellerStatus  @default(ACTIVE)
  // Platform commission this seller is charged on the goods value they sell
  // (basis points, Session 12). Bilokat's own storefront seller is 0.
  commissionRateBps Int           @default(0)
  // Session 14: additive organization binding. The seller's SELLER-type org
  // (Organization) plus a nullable direct link are populated for new/backfilled
  // sellers; existing `operators` (User[] via users.sellerId) is retained as a
  // denormalized convenience so prior commerce code is untouched.
  organizationId    String?
  organization      Organization? @relation("SellerOrg", fields: [organizationId], references: [id])
  activatedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  products      Product[] // products this seller owns
  sellerOrders  SellerOrder[]
  operators     User[]                @relation("SellerOperators") // SELLER-role users bound here
  payables      SellerPayable[]
  settlements   Settlement[]
  applications  SellerApplication[]
  documents     SellerDocument[]
  statusHistory SellerStatusHistory[]

  @@index([status])
  @@index([organizationId])
  @@map("sellers")
}

// Per-seller sub-order produced by splitting one customer order (DB-design §59).
// The customer Order remains the authoritative money/payment/refund entity; each
// SellerOrder carries that seller's attributed share of the order's totals so the
// seller can acknowledge and (later) fulfil/fund their own slice. Sum of all
// seller_orders.grandTotal reconciles exactly to orders.grandTotal.
model SellerOrder {
  id                 String            @id @default(cuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId           String
  seller             Seller            @relation(fields: [sellerId], references: [id])
  sellerOrderNumber  String            @unique
  status             SellerOrderStatus @default(PLACED)
  // Money attribution (see model note above for reconciliation semantics).
  subtotal           Decimal           @db.Decimal(12, 2)
  discountTotal      Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal           @default(0) @db.Decimal(12, 2)
  deliveryTotal      Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal           @db.Decimal(12, 2)
  sellerAmount       Decimal           @db.Decimal(12, 2) // attributable payout basis (settlement deferred)
  acceptedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  // Per-seller fulfilment markers (Session 10): stamped when the order-level
  // fulfilment reaches SHIPPED / DELIVERED (order-level delivery covers the
  // accepted seller slices together). Fulfilment state lives on the order;
  // these record each seller slice's ship/deliver point-in-time.
  shippedAt          DateTime?
  deliveredAt        DateTime?
  // Set when a REJECTED slice is resolved to a cancellation (Session 11 partial
  // fulfilment: that seller's items are removed from the shipment and (PREPAID)
  // the customer is refunded this slice's share).
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  items               OrderItem[]
  refunds             Refund[]
  payable             SellerPayable? // Session 12: authoritative settlement basis for this slice
  deliveryAssignments DeliveryAssignment[] // Session 15: per-slice courier handoff

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
  @@map("seller_orders")
}

// ===================== Session 12: Seller payables & settlements =====================

// A delivered seller slice's money is "earned" by the seller. Lifecycle:
// EARNED (auto at DELIVERED) -> IN_SETTLEMENT (rolled into a settlement) ->
// SETTLED (its settlement is PAID).
enum PayableStatus {
  EARNED
  IN_SETTLEMENT
  SETTLED
}

// Settlement workflow statuses (DB-design §104/§84). Lean subset actually used:
// PENDING -> APPROVED -> PROCESSING -> PAID -> RECONCILED; PROCESSING -> FAILED,
// FAILED -> PROCESSING (retry). No historical value is rewritten; each step is an
// audited SettlementEvent.
enum SettlementStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  RECONCILED
  FAILED
}

// Authoritative per-seller payout for one fulfilled (delivered, non-cancelled)
// seller slice. Auto-created when the order reaches DELIVERED for each slice that
// is ACCEPTED (a Session-11 cancelled/REJECTED slice never earns). Money rule
// (owner-selected, Session 12): the seller earns the slice's goods value
// (subtotal - discount) MINUS platform commission on that value; Bilokat retains
// the tax (remitted) and delivery charge. So for a slice:
//   goodsValue        = subtotal - discount
//   commissionAmount  = round(goodsValue * rateBps / 10000)
//   netPayable        = goodsValue - commission - refunds - adjustments
// and slice.grandTotal (= goodsValue + tax + delivery) reconciles to seller
// netPayable + commission + tax + delivery exactly (see VERIFICATION Session 12).
model SellerPayable {
  id            String      @id @default(cuid())
  sellerId      String
  seller        Seller      @relation(fields: [sellerId], references: [id])
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // One payable per delivered slice; the unique prevents double-earning.
  sellerOrderId String      @unique
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)

  grossAmount       Decimal @db.Decimal(12, 2) // slice.subtotal (goods selling value pre-discount)
  discountAmount    Decimal @default(0) @db.Decimal(12, 2)
  goodsValue        Decimal @db.Decimal(12, 2) // grossAmount - discountAmount
  commissionRateBps Int     @default(0)
  commissionAmount  Decimal @default(0) @db.Decimal(12, 2)
  // Bilokat-retained pass-through, recorded for reconciliation (not subtracted
  // from the seller's net under the goods-minus-commission rule).
  taxAmount         Decimal @default(0) @db.Decimal(12, 2)
  deliveryAmount    Decimal @default(0) @db.Decimal(12, 2)
  refundAmount      Decimal @default(0) @db.Decimal(12, 2)
  adjustmentAmount  Decimal @default(0) @db.Decimal(12, 2) // net signed adjustments
  netPayable        Decimal @db.Decimal(12, 2) // goodsValue - commission - refund - adjustment
  currency          String  @default("INR")

  status    PayableStatus @default(EARNED)
  earnedAt  DateTime      @default(now())
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  adjustments    SellerPayableAdjustment[]
  settlementItem SettlementItem?

  @@index([sellerId, status])
  @@index([orderId])
  @@map("seller_payables")
}

// Append-only traceable correction to an earned payable (DB-design §85/§106):
// never rewrite the snapshot, add a signed adjustment with reason + actor. The
// payable's netPayable reflects goodsValue - commission - refunds - adjustments.
model SellerPayableAdjustment {
  id              String        @id @default(cuid())
  sellerPayableId String
  sellerPayable   SellerPayable @relation(fields: [sellerPayableId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2) // signed: negative reduces the seller's net
  reason          String
  actorType       String // OPERATOR | SELLER | SYSTEM
  actorId         String?
  createdAt       DateTime      @default(now())

  @@index([sellerPayableId])
  @@map("seller_payable_adjustments")
}

// A batch of earned payables for one seller, to be paid out together.
model Settlement {
  id                  String           @id @default(cuid())
  sellerId            String
  seller              Seller           @relation(fields: [sellerId], references: [id])
  settlementReference String           @unique
  periodStart         DateTime?
  periodEnd           DateTime?
  status              SettlementStatus @default(PENDING)
  currency            String           @default("INR")

  grossAmount      Decimal @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  goodsValue       Decimal @default(0) @db.Decimal(12, 2)
  commissionAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal @default(0) @db.Decimal(12, 2)
  deliveryAmount   Decimal @default(0) @db.Decimal(12, 2)
  refundAmount     Decimal @default(0) @db.Decimal(12, 2)
  adjustmentAmount Decimal @default(0) @db.Decimal(12, 2)
  netPayable       Decimal @default(0) @db.Decimal(12, 2)

  approvedAt   DateTime?
  processedAt  DateTime?
  paidAt       DateTime?
  reconciledAt DateTime?
  failedAt     DateTime?
  failedReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items  SettlementItem[]
  events SettlementEvent[]

  @@index([sellerId, status])
  @@index([status])
  @@map("settlements")
}

// Traceability from a settlement to the individual earned payable (DB-design §105).
// sellerPayableId is unique so a payable can never sit in two settlements.
model SettlementItem {
  id              String        @id @default(cuid())
  settlementId    String
  settlement      Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  sellerPayableId String        @unique
  sellerPayable   SellerPayable @relation(fields: [sellerPayableId], references: [id], onDelete: Cascade)
  sellerOrderId   String // denormalised reference for traceability
  amount          Decimal       @db.Decimal(12, 2) // the payable's netPayable at inclusion
  createdAt       DateTime      @default(now())

  @@index([settlementId])
  @@map("settlement_items")
}

// Immutable per-settlement lifecycle audit.
model SettlementEvent {
  id           String     @id @default(cuid())
  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  eventType    String // CREATED | APPROVED | PROCESSING | PAID | RECONCILED | FAILED | RETRY
  actorId      String?
  reason       String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([settlementId])
  @@map("settlement_events")
}

// ===================== Session 14: Organizations + seller onboarding/KYC =====================

enum OrganizationType {
  SELLER
  INTERNAL
  PARTNER
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum OrganizationMemberRole {
  OWNER // founder/owner operator of the seller org
  OPERATOR // day-to-day operator within the seller org
  VIEWER // read-only within the org
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  type      OrganizationType   @default(SELLER)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  sellers Seller[]             @relation("SellerOrg")
  members OrganizationMember[]

  @@index([type])
  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole   @default(OPERATOR)
  status         OrganizationMemberStatus @default(ACTIVE)
  joinedAt       DateTime                 @default(now())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

enum SellerApplicationStatus {
  DRAFT // in progress, not submitted
  SUBMITTED // awaiting review
  UNDER_REVIEW // reviewer has begun
  RESUBMITTED // resubmitted after correction
  CORRECTION_REQUIRED // reviewer asked for changes
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  REJECTED
}

enum SellerDocumentType {
  GST_CERTIFICATE
  PAN_CARD
  BANK_ACCOUNT_PROOF
  ADDRESS_PROOF
  BUSINESS_REGISTRATION
  ID_PROOF
  OTHER
}

enum DocumentVerificationStatus {
  PENDING // uploaded, not yet reviewed
  SUBMITTED
  VERIFIED // reviewer approved
  REJECTED
}

enum ReviewDecision {
  APPROVE
  REJECT
  CORRECTION_REQUIRED
  ADDITIONAL_INFORMATION_REQUIRED
}

model SellerApplication {
  id                String                  @id @default(cuid())
  sellerId          String
  seller            Seller                  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  applicationNumber String                  @unique
  status            SellerApplicationStatus @default(DRAFT)
  // Business / KYC profile captured on the application (representative typed subset;
  // official identity records are the SellerDocuments. Bank details stored as safe
  // last-4 + IFSC rather than full account numbers).
  gstin             String?
  pan               String?
  businessAddress   String?
  city              String?
  state             String?
  bankAccountHolder String?
  bankAccountLast4  String?
  bankIfsc          String?
  payoutPreference  String?
  agreedToTerms     Boolean                 @default(false)
  agreedToTermsAt   DateTime?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectionReason   String?
  correctionReason  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  reviews   SellerReview[]
  documents SellerDocument[]

  @@index([sellerId])
  @@index([status])
  @@map("seller_applications")
}

model SellerDocument {
  id              String                     @id @default(cuid())
  sellerId        String
  seller          Seller                     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  applicationId   String?
  application     SellerApplication?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  documentType    SellerDocumentType
  storageObjectId String                     @unique
  fileName        String
  mimeType        String?
  sizeBytes       Int?
  status          DocumentVerificationStatus @default(PENDING)
  uploadedBy      String?
  uploadedAt      DateTime                   @default(now())
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  createdAt       DateTime                   @default(now())

  @@index([sellerId])
  @@index([documentType])
  @@map("seller_documents")
}

// Audited reviewer decisions on an application.
model SellerReview {
  id                  String            @id @default(cuid())
  sellerApplicationId String
  sellerApplication   SellerApplication @relation(fields: [sellerApplicationId], references: [id], onDelete: Cascade)
  reviewerId          String
  decision            ReviewDecision
  reason              String?
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([sellerApplicationId])
  @@map("seller_reviews")
}

// Immutable seller lifecycle audit (Session 14 onboarding status transitions).
model SellerStatusHistory {
  id         String        @id @default(cuid())
  sellerId   String
  seller     Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  fromStatus SellerStatus?
  toStatus   SellerStatus
  changedBy  String?
  reason     String?
  createdAt  DateTime      @default(now())

  @@index([sellerId])
  @@map("seller_status_history")
}

// ===================== Session 15: Per-slice delivery / courier handoff =====================
// Courier last-mile model layered on the existing order-level delivery + money
// trigger (owner decision: seller payables still auto-earn at order DELIVERED).
// An operator assigns each ACCEPTED, not-yet-delivered seller slice to a DELIVERY
// partner; the partner moves that slice's assignment through the courier lifecycle.
// When the last outstanding slice is DELIVERED the order is finalized to DELIVERED
// (existing earn/COD/audit path reused). This is additive; the legacy OPERATOR
// order-level advance remains for back-office flow.

enum DeliveryPartnerStatus {
  REGISTERED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum DeliveryAssignmentStatus {
  ASSIGNED // operator assigned to a partner; awaiting partner acceptance
  ACCEPTED // partner accepted the slice
  PICKED_UP // partner collected the slice from the seller/warehouse
  OUT_FOR_DELIVERY // in transit to the customer
  DELIVERED // handed to the customer; drives per-slice deliveredAt
  REJECTED // partner declined the assignment (operator reassigns)
  FAILED // partner reported a failed delivery attempt
  CANCELLED // operator cancelled the assignment
}

model DeliveryPartner {
  id          String                @id @default(cuid())
  userId      String                @unique
  user        User                  @relation(fields: [userId], references: [id])
  partnerCode String                @unique
  status      DeliveryPartnerStatus @default(REGISTERED)
  vehicleType String?
  // live location optional (kept minimal; precise location per privacy rules)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  assignments            DeliveryAssignment[]
  replacementAssignments ReplacementAssignment[] // Session 22
  courierPayouts         CourierPayout[]        // Session 32 — per-delivered-leg delivery fee owed to this partner

  @@index([status])
  @@map("delivery_partners")
}

model DeliveryAssignment {
  id                String                   @id @default(cuid())
  orderId           String
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrderId     String
  sellerOrder       SellerOrder              @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner?         @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  assignmentNumber  String                   @unique
  status            DeliveryAssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime                 @default(now())
  acceptedAt        DateTime?
  pickedUpAt        DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  rejectedAt        DateTime?
  failureReason     String?
  cancelledAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // Session 30 — external courier-provider tracking + proof-of-delivery (POD).
  carrier          String? // courier provider name (e.g. 'Sandbox Courier', or the env-configured provider)
  trackingNumber   String? // provider waybill / tracking number (booked once a parcel is picked up)
  trackingUrl      String? // provider tracking page (optional)
  podRef           String? // provider proof-of-delivery reference (recorded on the final deliver)
  podSignedBy      String?
  podAt            DateTime?

  events DeliveryEvent[]

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@map("delivery_assignments")
}

model DeliveryEvent {
  id                   String             @id @default(cuid())
  deliveryAssignmentId String
  deliveryAssignment   DeliveryAssignment @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Cascade)
  eventType            String
  actorType            String // CONTROL (operator) | DELIVERY (partner) | SYSTEM
  actorId              String?
  note                 String?
  createdAt            DateTime           @default(now())

  @@index([deliveryAssignmentId])
  @@map("delivery_events")
}

// Session 22 — ReplacementAssignment: the courier last-mile leg for a dispatched
// replacement (an outbound exchange to the customer). OPERATOR dispatches the
// replacement (Session 17, PENDING_DISPATCH -> DISPATCHED) and then assigns a
// DELIVERY partner here; the partner drives it through the courier lifecycle and
// its DELIVERED step auto-completes the replacement (DISPATCHED -> COMPLETED).
// This is a NON-money leg (no Refund, no seller payable, no order status change) —
// the original return order is already DELIVERED. Reuses DeliveryPartner +
// DeliveryAssignmentStatus so the DELIVERY role works uniformly. A replacement may
// have multiple rows over time (reject/fail -> operator reassigns a fresh one), but
// only one active assignment at a time.
model ReplacementAssignment {
  id                String                   @id @default(cuid())
  replacementId     String
  replacement       Replacement              @relation(fields: [replacementId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner?         @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  assignmentNumber  String                   @unique // RDLA-XXXX
  status            DeliveryAssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime                 @default(now())
  acceptedAt        DateTime?
  pickedUpAt        DateTime?
  outForDeliveryAt  DateTime?
  deliveredAt       DateTime?
  rejectedAt        DateTime?
  failureReason     String?
  cancelledAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  // Session 30 — external courier-provider tracking + proof-of-delivery (POD).
  carrier          String?
  trackingNumber   String?
  trackingUrl      String?
  podRef           String?
  podSignedBy      String?
  podAt            DateTime?

  @@index([replacementId])
  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@map("replacement_assignments")
}

// Session 20 — immutable per-product catalog status audit. Records every
// product lifecycle transition (seller draft/edit/submit, staff approve/reject)
// with the actor role + optional reason, mirroring the SellerStatusHistory style.
model ProductStatusHistory {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStatus ProductStatus?
  toStatus   ProductStatus
  actorRole  String // SELLER | OPERATOR | ADMIN | SYSTEM
  actorId    String?
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([productId])
  @@map("product_status_history")
}

// ===================== Session 32: Courier delivery-fee payout (money leg) =====================
// A per-delivered-leg delivery fee the platform owes a DELIVERY partner for each
// successful courier delivery — one EARNED row per slice-parcel delivery and one
// per outbound replacement delivery (the earlier "non-money" invariant for courier
// steps is deliberately extended here to accrue this courier fee; it is a separate
// platform→courier payable and never touches a Refund / seller payable / COD money).
enum CourierPayoutStatus {
  EARNED // owed, not yet paid out
  SETTLED // paid out by back-office
  CANCELLED
}

model CourierPayout {
  id                  String               @id @default(cuid())
  deliveryPartnerId   String
  deliveryPartner     DeliveryPartner      @relation(fields: [deliveryPartnerId], references: [id])
  kind                String // 'parcel' (slice delivery) | 'replacement' (outbound replacement)
  orderId             String
  // Traceability to the exact delivered courier leg. Each is unique so a leg can
  // never earn more than one payout (double-earn guard).
  sellerOrderId             String?
  deliveryAssignmentId      String?  @unique
  replacementAssignmentId   String?  @unique
  feeAmount           Decimal              @db.Decimal(12, 2) // delivery fee owed to the partner (₹)
  currency            String               @default("INR")
  status              CourierPayoutStatus  @default(EARNED)
  earnedAt            DateTime             @default(now())
  settledAt           DateTime?
  settledById         String? // back-office actor who paid it out
  cancelledAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([deliveryPartnerId, status])
  @@index([kind])
  @@index([orderId])
  @@map("courier_payouts")
}

// ============================================================================
// Session 38 — Finance/payout notifications (in-app ledger + dispatch outbox).
// Additive. When a money event happens (a courier fee is earned/settled, a seller
// payable is earned, a settlement advances) we write an in-app Notification row
// to the money-owner's user (DELIVERY partner / SELLER operator) and enqueue
// NotificationOutbox dispatch rows (EMAIL/SMS). A dispatch gateway processes the
// outbox; with no provider configured rows resolve to SKIPPED (never retried).
// This ledger is purely informational — it never affects the money flow.
// ============================================================================

enum NotificationCategory {
  COURIER_FEE_EARNED
  COURIER_FEE_SETTLED
  PAYABLE_EARNED
  SETTLEMENT_ADVANCED
  // Session 40 — buyer-facing lifecycle notices (refunds / returns / replacements)
  ORDER_STATUS
  RETURN_STATUS
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id            String               @id @default(cuid())
  recipientUserId String             // User the notice is for (DELIVERY partner / SELLER operator)
  recipientUser User                 @relation(fields: [recipientUserId], references: [id])
  category      NotificationCategory
  title         String
  message       String
  refKind       String?              // e.g. 'courierPayout' | 'sellerPayable' | 'settlement'
  refId         String?              // the money row this notice refers to
  readAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  outboxes NotificationOutbox[]

  @@index([recipientUserId, createdAt])
  @@map("notifications")
}

model NotificationOutbox {
  id             String            @id @default(cuid())
  notificationId String
  notification   Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  destination    String            // resolved contact: email address or phone (may be empty/redacted)
  status         OutboxStatus      @default(PENDING)
  attempt        Int               @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([status, createdAt])
  @@map("notification_outbox")
}

// ===================== Session 43: Platform Control Panel =====================
// Append-only, high-authority platform-action audit (Control-Panel spec §51/§52).
// Every sensitive "break-glass"/governance action taken through the Control Panel
// (e.g. an OPERATOR/ADMIN revoking another user's session) is recorded here with a
// mandatory reason + actor. This is the platform-governance audit trail distinct
// from the domain history tables (which remain the source for their own state
// transitions); Control actions that overlap an existing domain transition still
// write that domain's history AND a ControlAudit entry.
enum ControlActionType {
  SESSION_REVOKE
  SESSION_REVOKE_ALL
  SELLER_SUSPEND
  SELLER_ACTIVATE
  USER_STATUS_CHANGE
  CATALOG_OVERRIDE
  PAYMENT_OVERRIDE
  OTHER
}

model ControlAudit {
  id         String             @id @default(cuid())
  actionType ControlActionType
  action     String // human summary, e.g. 'Revoked a platform session'
  actorId    String // OPERATOR/ADMIN user who performed it
  actorRole  String // OPERATOR | ADMIN
  targetType String // 'userSession' | 'user' | 'seller' | ...
  targetId   String?
  reason     String // mandatory free-text justification
  detail     Json? // optional structured context (ip, device, target email, ...)
  createdAt  DateTime           @default(now())

  @@index([actorId])
  @@index([actionType])
  @@index([createdAt])
  @@map("control_audit")
}
